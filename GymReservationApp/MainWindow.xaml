<Window x:Class="GymReservationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GymReservationApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <StackPanel Margin="20">

        <TextBlock Text="Edzőtermi foglalás"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Név:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

        <TextBlock Text="Foglalás típusa:"/>
        <ComboBox x:Name="TypeBox"
                  SelectedIndex="0"
                  Margin="0,5,0,10">
            <ComboBoxItem Content="Egyéni"/>
            <ComboBoxItem Content="Csoportos"/>
        </ComboBox>

        <TextBlock Text="Időpont:"/>
        <ComboBox x:Name="TimeBox" Margin="0,5,0,15"/>

        <Button Content="Foglalás"
                Height="35"
                Click="BookButton_Click"/>

        <TextBlock Text="Foglalások:"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,20,0,5"/>

        <ListBox x:Name="ReservationsList"
                 Height="150"/>

    </StackPanel>
</Window>
